#!/bin/sh
# Проверки идут нативно, если на хосте установлены зависимости, и только
# иначе — через контейнер. Причина: при нескольких параллельных агентах
# контейнер становится очередью, и хук ждёт минутами (ADR-043).
#
# 🔴 Что хук проверяет: формат и линтеры по изменённым файлам плюс тесты,
# зависящие от них (`vitest related`, ADR-147). Проверки типов здесь нет
# намеренно — объяснение в ADR-147: на хосте `tsc` даёт ложные ошибки, потому
# что типы типизированных маршрутов Next генерируются в `.next`, а он живёт в
# томе контейнера. Типы проверяет `pnpm check` в контейнере и CI.
if [ -x node_modules/.bin/lint-staged ]; then
  node_modules/.bin/lint-staged --no-stash
  exit $?
fi

if [ -z "$(docker compose -f docker-compose.dev.yml ps -q web 2>/dev/null)" ]; then
  echo "Ни зависимостей на хосте, ни поднятого контейнера — проверить нечем."
  echo "Либо pnpm install, либо docker compose -f docker-compose.dev.yml up -d"
  exit 1
fi
docker compose -f docker-compose.dev.yml exec -T web pnpm lint-staged --no-stash
