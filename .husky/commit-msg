#!/bin/sh
# Conventional Commits (ADR-018). Нативно, если есть зависимости на хосте.
if [ -x node_modules/.bin/commitlint ]; then
  node_modules/.bin/commitlint < "$1"
  exit $?
fi

if [ -z "$(docker compose -f docker-compose.dev.yml ps -q web 2>/dev/null)" ]; then
  echo "Ни зависимостей на хосте, ни поднятого контейнера — проверить нечем."
  exit 1
fi
docker compose -f docker-compose.dev.yml exec -T web pnpm commitlint < "$1"
