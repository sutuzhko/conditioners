# pnpm: строгий режим, чтобы фантомные зависимости ловились локально, а не в проде
strict-peer-dependencies=false
auto-install-peers=true
shamefully-hoist=false

# Store должен лежать в томе контейнера, а не в бинд-маунте: на файловой системе
# macOS, проброшенной в Linux, установка десятков тысяч мелких файлов идёт
# катастрофически медленно. Путь совпадает с томом pnpm_store в compose.
store-dir=/pnpm/store
