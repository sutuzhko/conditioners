# pnpm: строгий режим, чтобы фантомные зависимости ловились локально, а не в проде
strict-peer-dependencies=false
auto-install-peers=true
shamefully-hoist=false

# Store в контейнере должен лежать в томе, а не в бинд-маунте: на файловой
# системе macOS, проброшенной в Linux, установка десятков тысяч мелких файлов
# идёт катастрофически медленно (ADR-028).
#
# 🔴 Путь задаётся переменной PNPM_STORE_DIR в docker-compose, а не здесь:
# файл общий для контейнера и хоста, и абсолютный контейнерный путь ломал
# установку на macOS — pnpm пытался создать каталог `/pnpm` в корне диска и
# падал с ENOENT, оставляя пустой node_modules.
