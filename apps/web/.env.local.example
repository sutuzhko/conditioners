# Окружение для запуска приложения НА ХОСТЕ, мимо Docker (docs/DEPLOY.md §2).
#
# Копируется в `apps/web/.env.local` — это имя Next читает сам, а docker
# compose не читает вовсе (ему отдан `.env.dev`). Поэтому два режима не мешают
# друг другу и переключаются командой запуска, а не правкой файлов.
#
# 🔴 Файл лежит рядом с приложением, а не в корне репозитория: Next ищет
# `.env.local` от своего каталога. В корне он не подхватится, и приложение
# упадёт на старте с «Некорректная конфигурация окружения» — проверено.
#
# В контейнере поднимается только база: она занимает 27 МБ, тогда как контейнер
# приложения — до двух гигабайт (замер 29 августа).

NODE_ENV=development
SITE_URL=http://localhost:3000

# ========= База =========
# 🔴 Хост здесь `127.0.0.1`, а не `db`: имя сервиса compose разрешается только
# внутри сети контейнеров. Порт уже проброшен на петлю docker-compose.dev.yml.
DATABASE_URL=postgresql://tk:devpass@127.0.0.1:5432/tulaklimat?schema=public

# ========= Сессия и вход =========
# 🔴 Секрет тот же, что в `.env.dev`, и это не небрежность.
#
# Им подписывается cookie сессии. Разные секреты в двух режимах означают, что
# вход, сделанный в одном, в другом не признаётся — а браузер приходит со
# старой cookie и попадает в петлю редиректов между `/admin` и `/admin/login`.
# Проверено: ERR_TOO_MANY_REDIRECTS ровно по этой причине.
SESSION_SECRET=dev-secret-not-for-production
ADMIN_LOGIN=admin

# 🔴 Доллары здесь ОДИНАРНЫЕ, в отличие от `.env.dev`.
#
# Там они удвоены намеренно: docker compose подставляет `$` как переменную, и
# хеш Argon2id иначе приезжает в контейнер обрезанным. Next читает `.env.local`
# сам, без Compose, и удвоение оставил бы в хеше лишние символы — `verify`
# всегда возвращал бы false, а в панель не пускало бы с верным паролем.
#
# Пароль — `admin`.
ADMIN_PASSWORD_HASH=$argon2id$v=19$m=19456,t=2,p=1$NhX/2bCVHLJzn98we20/DQ$8SG+Y5V7q5LMoWaTuKnWUhyirj0HvPduRRM9l1ttmi8

# ========= Загрузки =========
# 🔴 Путь хоста, а не `/data/uploads`: такого каталога на машине нет, и первая
# же загрузка файла упала бы. Разрешается от каталога приложения (`apps/web`),
# каталог создаётся при первой загрузке.
UPLOADS_DIR=.data/uploads
UPLOAD_MAX_BYTES=5242880

# ========= Уведомления =========
# 🔴 `log`, а не `live`: на хосте нет воркера, и слать что-то по-настоящему
# некому. Схема окружения при `live` потребует настроенного канала и не
# поднимет приложение вовсе (ADR-172).
NOTIFY_DRIVER=log
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
NOTIFY_EMAIL_TO=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_TRANSPORT=off
TELEGRAM_PROXY_URL=
TELEGRAM_WEBHOOK_SECRET=dev-webhook-secret

# ========= Аналитика =========
# Пусто: счётчик не должен собирать статистику с машины разработчика
NEXT_PUBLIC_YANDEX_METRIKA_ID=
