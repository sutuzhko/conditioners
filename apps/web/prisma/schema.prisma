// Схема данных. Обоснование полей — docs/PROJECT.md §3.
// Ключевые инварианты: характеристики товара произвольны (никаких фиксированных
// колонок), данные компании живут в Setting, отзывы не редактируются.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Каталог ----------

model Product {
  id        String    @id @default(cuid())
  slug      String    @unique
  badge     String // класс мощности: «09»
  name      String
  brand     String?
  sku       String?
  areaMax   Int
  tag       String?
  priceNum  Int // обычная цена
  salePrice Int? // цена со скидкой; null = скидки нет
  saleFrom  DateTime?
  saleTo    DateTime?
  saleLabel String?
  link      String?

  // `visible` — модель в продаже и попадает в каталог. `featured` — владелец
  // вынес её на главную. Это разные вопросы: каталог показывает всё, что есть
  // в продаже, витрина лендинга — то, что владелец хочет продать сегодня.
  // Порядок в обоих случаях задаёт `sort`.
  visible  Boolean @default(true)
  featured Boolean @default(false)
  sort     Int     @default(0)

  seoTitle       String?
  seoDescription String?

  photos    ProductPhoto[]
  specs     ProductSpec[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([visible, sort])
  @@index([featured, sort])
}

model ProductPhoto {
  id        String  @id @default(cuid())
  productId String
  url       String
  alt       String?
  isMain    Boolean @default(false)
  sort      Int     @default(0)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sort])
}

model ProductSpec {
  id        String  @id @default(cuid())
  productId String
  k         String
  v         String
  sort      Int     @default(0)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sort])
}

// ---------- Цены на монтаж ----------

model PriceRow {
  cls   String @id // «07» | «09» | «12» | «18»
  power String
  area  String
  price Int
  term  String
  sort  Int    @default(0)
}

// ---------- Настройки: всё о компании ----------
// Ключи: company, contacts, address, geo, area, legal, extras, warranty,
// payment, social, seo, achievements, integrations, notifications
// — см. docs/PROJECT.md §3

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

// ---------- База знаний ----------

model Article {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  category  String
  date      DateTime
  minutes   Int
  cover     String?
  excerpt   String
  body      String
  published Boolean  @default(false)

  seoTitle       String?
  seoDescription String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published, date])
}

// ---------- Отзывы ----------

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
  ARCHIVED
}

model Review {
  id     String @id @default(cuid())
  name   String
  rating Int
  text   String // неизменяем: модератор меняет только статус

  // Два разных снимка, и путать их нельзя: `photo` — место установки (по нему
  // видно и аккуратность бригады, и мусор, если он остался), `avatar` — сам
  // автор отзыва. Оба необязательны: отзыв без фотографий — обычное дело.
  photo  String?
  avatar String?
  status ReviewStatus @default(PENDING)

  // Доказательство согласия на обработку ПДн — по 152-ФЗ нужно так же,
  // как для заявки. Необязательное: у отзывов, заведённых до появления поля,
  // его нет, а выдумывать дату согласия нельзя.
  consentAt DateTime?

  createdAt DateTime @default(now())

  @@index([status, createdAt])
}

// ---------- Заявки ----------

enum LeadStatus {
  NEW
  IN_PROGRESS
  DONE
  REJECTED
}

model Lead {
  id       String  @id @default(cuid())
  name     String
  phone    String
  topic    String
  place    String?
  qty      String?
  callTime String?
  address  String?
  comment  String?
  photo    String?

  sourceUrl String?
  referrer  String?
  utm       Json?

  consentAt DateTime // доказательство согласия на обработку ПДн (152-ФЗ)

  status         LeadStatus @default(NEW)
  managerComment String?

  // Клиент, в которого выросло обращение (ADR-105). Связь заводится вручную
  // из карточки заявки: класть в постоянную базу каждого, кто спросил цену,
  // — и лишние ПДн, и мусор в списке.
  //
  // `SetNull`, а не каскад: удаление карточки клиента по требованию субъекта
  // не стирает заявку — у неё своё согласие и свой срок хранения.
  clientId String?
  client   Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events CrmEvent[]
  orders Order[]

  @@index([status, createdAt])
  @@index([clientId])
}

// ---------- Клиенты ----------
// Заявка отвечает на вопрос «кто обратился», клиент — «с кем мы работаем».
// Это разные сроки жизни: обращение закрывается, человек остаётся — у него
// адрес, история работ и техника, которую ему поставили (ADR-105).

model Client {
  id   String @id @default(cuid())
  name String

  // Телефон хранится дважды намеренно. `phone` — как его ввели: владелец
  // узнаёт свою запись и диктует номер в привычном виде. `phoneKey` — только
  // цифры, приведённые к коду 7: «+7 (910) 155-24-68» и «8 910 155 24 68» —
  // один и тот же человек, и второй карточки у него быть не должно.
  phone    String
  phoneKey String @unique

  address String?
  note    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  leads  Lead[]
  orders Order[]

  // Список открывают, чтобы найти человека: свежие сверху, поиск по остальным.
  @@index([createdAt])
}

// ---------- Заказы (наряды) ----------
// Работа с деньгами, датой и исполнителем. Дело в календаре — напоминание
// без денег; монтаж, ТО и ремонт заводятся нарядом (ADR-093).

enum OrderType {
  INSTALL // монтаж
  SERVICE // обслуживание, ТО
  REPAIR // ремонт
}

enum OrderStatus {
  NEW // заведён, исполнитель не назначен
  ASSIGNED // назначен монтажнику
  IN_PROGRESS // монтажник в работе
  DONE // выполнен
  CANCELLED // отказ
}

enum PaymentMode {
  COMPANY // клиент платит компании
  CASH_TO_INSTALLER // наличными монтажнику на объекте
}

model Order {
  id String @id @default(cuid())

  // Владелец видит номер как «№ 1059» и ждёт непрерывности, поэтому счётчик
  // свой (`Setting.orderSeq`), а не автоинкремент Postgres: тот оставляет
  // дыры на каждой откатанной транзакции.
  number Int         @unique
  type   OrderType
  status OrderStatus @default(NEW)

  // Клиент обязателен: наряд без человека, к которому едут, — это дело в
  // календаре, а не работа. `Restrict`: клиента с историей работ не удаляют
  // молча, сначала разбираются с нарядами.
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Restrict)

  // Исполнитель. `SetNull`: уволенный монтажник исчезает из учётных записей,
  // но выполненный им наряд остаётся в истории клиента.
  installerId String?
  installer   AdminUser? @relation(fields: [installerId], references: [id], onDelete: SetNull)

  // Момент в UTC, показывается в московском — как у дела календаря (ADR-080).
  at DateTime

  // Длительность в минутах, а не в часах: полтора часа на ТО — обычное дело,
  // и загрузка бригад считается по минутам, а не округляется вверх.
  durationMin Int @default(120)

  // Объект. Адрес отдельно от адреса клиента: ставят и на даче, и в офисе.
  address     String
  intercom    String?
  phone2      String?
  floor       Int?
  heightWorks Boolean @default(false)

  // Деньги. Суммы целые: копеек на этом рынке не бывает.
  payment      PaymentMode @default(COMPANY)
  price        Int         @default(0)
  installerFee Int         @default(0)

  // 🔴 Не «штраф»: штрафов как вида взыскания в ТК РФ нет, а уменьшение
  // вознаграждения по ГПХ законно только когда прописано в договоре
  // (CRM.md §9). Поле учётное, основание обязательно при ненулевой сумме —
  // проверяет схема Zod, а не база.
  deductionSum    Int     @default(0)
  deductionReason String?

  // Комментарий монтажник видит, заметку владельца — нет. Это разные поля,
  // а не одно с флагом: «не отдавать наружу» должно решаться выбором поля.
  comment   String?
  ownerNote String?

  // Обращение, из которого вырос наряд. `SetNull`: удалённая заявка не
  // отменяет работу, о которой уже договорились.
  leadId String?
  lead   Lead?   @relation(fields: [leadId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  units OrderUnit[]

  @@index([status, at])
  @@index([clientId])
  @@index([installerId, at])
  @@index([at])
}

enum OrderEquip {
  CONDITIONER // кондиционер
  FRIDGE // холодильник
  COMPRESSOR // компрессор
  VENTILATION // вентиляция
  HEAT_CURTAIN // тепловая завеса
  OTHER // другое
}

enum UnitSource {
  OURS // наше оборудование: продажа с монтажом
  CLIENT // оборудование клиента: только работы
}

// Позиция оборудования в наряде. Список, а не одно поле: половина заказов —
// монтаж техники, купленной клиентом, и в одном выезде бывает два блока с
// разными условиями (CRM.md §3.3).
model OrderUnit {
  id      String     @id @default(cuid())
  orderId String
  order   Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  equip   OrderEquip @default(CONDITIONER)

  // Модель строкой, а не ссылкой на каталог: ставят и то, что клиент купил
  // сам, — такой техники в каталоге нет и быть не должно.
  model String?

  source UnitSource @default(OURS)

  // Трасса в метрах и диаметр — по ним собирается чеклист выезда и считается
  // смета. Диаметр строкой: пишут «1/4–3/8», а не число.
  trassaM  Int?
  diameter String?
  shtrob   Boolean @default(false)

  sort Int @default(0)

  @@index([orderId, sort])
}

// ---------- Календарь работ ----------
// Заявка говорит, что человек обратился. Календарь — что с ним происходит
// дальше: когда выехали на замер, когда монтаж, когда перезвонить.

enum CrmEventKind {
  CALL // позвонить
  MEASURE // выезд на замер
  INSTALL // монтаж
  SERVICE // обслуживание, чистка
  MEETING // встреча
  NOTE // прочее: то, что просто нужно помнить в этот день
}

enum CrmEventStatus {
  PLANNED
  DONE
  CANCELLED
}

model CrmEvent {
  id     String         @id @default(cuid())
  kind   CrmEventKind
  status CrmEventStatus @default(PLANNED)

  // Момент времени в UTC. Владелец вводит и видит московское время: часовой
  // пояс дела задаёт город работ, а не настройки браузера у того, кто смотрит.
  at DateTime

  // Клиент вписывается строками, а не ссылкой на заявку: половина работ
  // приходит по звонку и сарафану, и такое дело обязано попадать в календарь
  // без выдуманной заявки на сайте.
  clientName  String
  clientPhone String?
  address     String?
  note        String?

  // Заявка, из которой выросло дело. `SetNull`, а не каскад: удалённая заявка
  // не отменяет монтаж, о котором уже договорились с человеком.
  leadId String?
  lead   Lead?   @relation(fields: [leadId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([at])
  @@index([leadId])
}

// ---------- Очередь уведомлений ----------
// Заявка сначала попадает в БД, уведомление — отдельная сущность с ретраями.

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

model Notification {
  id        String             @id @default(cuid())
  channel   String // «email» | «telegram»
  kind      String // «lead» | «review» | «to-reminder»
  payload   Json
  status    NotificationStatus @default(PENDING)
  attempts  Int                @default(0)
  lastError String?
  nextTryAt DateTime           @default(now())
  createdAt DateTime           @default(now())
  sentAt    DateTime?

  @@index([status, nextTryAt])
}

// ---------- Админка ----------

// Ролей две, и обе — люди с логином и паролем: монтажник заходит в ту же
// панель, просто видит из неё три раздела вместо тринадцати (ADR-092).
enum AdminRole {
  OWNER
  INSTALLER
}

// Как оформлены отношения с человеком. От этого зависит, чем является
// удержание в наряде: у самозанятого и подрядчика по ГПХ это законное
// уменьшение вознаграждения, когда оно прописано в договоре; у работника по
// трудовому договору штрафов как взыскания в ТК РФ нет вовсе, и запись
// остаётся внутренней пометкой о браке или срыве (CRM.md §9).
enum Employment {
  SELF_EMPLOYED // самозанятый
  CONTRACT // договор ГПХ
  STAFF // трудовой договор
}

model AdminUser {
  id           String    @id @default(cuid())
  login        String    @unique
  passwordHash String
  role         AdminRole @default(OWNER)

  // Необязательно: у владельца оформления нет, а у монтажника оно может быть
  // ещё не заведено. Выдумывать его нельзя — от него зависят деньги.
  employment Employment?

  // Имя и телефон нужны в наряде и в списке команды. Необязательные: у учётной
  // записи владельца, заведённой сидом, имени может не быть, и выдумывать его
  // нельзя — интерфейс покажет логин.
  name  String?
  phone String?

  // Отключение закрывает вход, но сохраняет историю: выполненные наряды
  // остаются за человеком, даже когда он больше не работает.
  active Boolean @default(true)

  createdAt   DateTime  @default(now())
  lastLoginAt DateTime?

  sessions Session[]
  notes    InstallerNote[]
  orders   Order[]

  @@index([role, active])
}

// Заметки владельца о монтажнике. Сам монтажник их не видит — поэтому это
// отдельная таблица, а не поле в `AdminUser`: так «не отдавать наружу» —
// решение о том, присоединять ли связь, а не о том, вырезать ли поле.
model InstallerNote {
  id        String    @id @default(cuid())
  userId    String
  text      String
  createdAt DateTime  @default(now())
  user      AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model Session {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  createdAt DateTime  @default(now())
  user      AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

// ---------- Антиспам ----------

model RateLimit {
  id       String   @id @default(cuid())
  key      String // ip + endpoint
  windowAt DateTime
  hits     Int      @default(1)

  @@unique([key, windowAt])
  // чистка отработавших окон идёт диапазоном по времени — составной
  // уникальный индекс по [key, windowAt] такой запрос не обслуживает
  @@index([windowAt])
}
