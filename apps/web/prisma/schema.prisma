// Схема данных. Обоснование полей — docs/PROJECT.md §3.
// Ключевые инварианты: характеристики товара произвольны (никаких фиксированных
// колонок), данные компании живут в Setting, отзывы не редактируются.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Каталог ----------

model Product {
  id        String    @id @default(cuid())
  slug      String    @unique
  badge     String // класс мощности: «09»
  name      String
  brand     String?
  sku       String?
  areaMax   Int
  tag       String?
  priceNum  Int // обычная цена
  salePrice Int? // цена со скидкой; null = скидки нет
  saleFrom  DateTime?
  saleTo    DateTime?
  saleLabel String?
  link      String?

  // `visible` — модель в продаже и попадает в каталог. `featured` — владелец
  // вынес её на главную. Это разные вопросы: каталог показывает всё, что есть
  // в продаже, витрина лендинга — то, что владелец хочет продать сегодня.
  // Порядок в обоих случаях задаёт `sort`.
  visible  Boolean @default(true)
  featured Boolean @default(false)
  sort     Int     @default(0)

  seoTitle       String?
  seoDescription String?

  photos     ProductPhoto[]
  specs      ProductSpec[]
  stockItems StockItem[]
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@index([visible, sort])
  @@index([featured, sort])
}

model ProductPhoto {
  id        String  @id @default(cuid())
  productId String
  url       String
  alt       String?
  isMain    Boolean @default(false)
  sort      Int     @default(0)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sort])
}

model ProductSpec {
  id        String  @id @default(cuid())
  productId String
  k         String
  v         String
  sort      Int     @default(0)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sort])
}

// ---------- Цены на монтаж ----------

model PriceRow {
  cls   String @id // «07» | «09» | «12» | «18»
  power String
  area  String
  price Int
  term  String
  sort  Int    @default(0)
}

// ---------- Настройки: всё о компании ----------
// Ключи: company, contacts, address, geo, area, legal, extras, warranty,
// payment, social, seo, achievements, integrations, notifications
// — см. docs/PROJECT.md §3

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

// ---------- База знаний ----------

model Article {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  category  String
  date      DateTime
  minutes   Int
  cover     String?
  excerpt   String
  body      String
  published Boolean  @default(false)

  seoTitle       String?
  seoDescription String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published, date])
}

// ---------- Отзывы ----------

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
  ARCHIVED
}

model Review {
  id     String @id @default(cuid())
  name   String
  rating Int
  text   String // неизменяем: модератор меняет только статус

  // Два разных снимка, и путать их нельзя: `photo` — место установки (по нему
  // видно и аккуратность бригады, и мусор, если он остался), `avatar` — сам
  // автор отзыва. Оба необязательны: отзыв без фотографий — обычное дело.
  photo  String?
  avatar String?
  status ReviewStatus @default(PENDING)

  // Доказательство согласия на обработку ПДн — по 152-ФЗ нужно так же,
  // как для заявки. Необязательное: у отзывов, заведённых до появления поля,
  // его нет, а выдумывать дату согласия нельзя.
  consentAt DateTime?

  // ---------- Отказ ----------
  // 🔴 Единственное, что модератор пишет об отзыве сам (issue #522, ADR-300).
  // Инварианту 7 это не противоречит: причина относится к решению, а не к
  // отзыву, и живёт отдельными полями — текст автора по-прежнему неизменяем.
  //
  // Все три необязательны: у отзыва, который не отклоняли, отказа нет, а у
  // отклонённых до появления полей причины не существует — выдумывать её
  // нельзя. При возврате на модерацию поля гасятся: причина без отказа
  // читалась бы как действующая.
  rejectReason String?
  rejectedAt   DateTime?
  rejectedById String?
  // `SetNull`: уволенный модератор не уносит с собой причину отказа.
  rejectedBy   AdminUser? @relation("ReviewRejectedBy", fields: [rejectedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([status, createdAt])
}

// ---------- Заявки ----------

enum LeadStatus {
  NEW
  IN_PROGRESS
  DONE
  REJECTED
}

model Lead {
  id String @id @default(cuid())

  // Номер обращения, который владелец называет вслух: «по сорок первой
  // заявке перезвонили». Счётчик свой (`Setting.leadSeq`), а не автоинкремент
  // Postgres, — по той же причине, что у наряда (ADR-114): автоинкремент
  // оставляет дыру на каждой откатанной транзакции, а нумерация обращений
  // обязана быть непрерывной, иначе по ней нельзя сослаться.
  number Int @unique

  name     String
  phone    String
  topic    String
  // Модель, ради которой человек нажал кнопку: видимое поле формы, а не
  // невидимый снимок из `context` (ADR-129). Приходит заполненным по адресу
  // `?model=<слаг>`, но правится и стирается — это подсказка, а не замок,
  // поэтому здесь свободный текст, а не связь с моделью каталога.
  model    String?
  place    String?
  qty      String?
  callTime String?
  address  String?
  comment  String?
  photo    String?

  sourceUrl String?
  referrer  String?
  utm       Json?

  // Что человек делал на сайте до отправки формы: расчёт калькулятора, подбор
  // по площади, модель у кнопки «Заказать», отмеченные модели. Снимок на
  // момент отправки, а не ссылки: цены и каталог правятся, а владельцу нужно
  // видеть то, что человек видел перед звонком. Разбирается схемой Zod, как
  // и utm.
  context Json?

  consentAt DateTime // доказательство согласия на обработку ПДн (152-ФЗ)

  status         LeadStatus @default(NEW)
  managerComment String?

  // Почему отказались (ADR-310). Отмена — это состояние, а не удаление:
  // обращение остаётся в истории и в счётчиках конверсии, но без разбора
  // причин вкладка отказов не обобщает ничего.
  //
  // Код справочника строкой, а не перечислением базы: словарь общий с нарядом
  // (`shared/lib/cancel-reason`), и правка его состава не должна требовать
  // миграции. Неизвестный код проверяет схема Zod на входе.
  cancelReason String?
  // Свободное уточнение к выбранной причине: «просил перезвонить в мае».
  cancelNote   String?

  // Клиент, в которого выросло обращение (ADR-105). Связь заводится вручную
  // из карточки заявки: класть в постоянную базу каждого, кто спросил цену,
  // — и лишние ПДн, и мусор в списке.
  //
  // `SetNull`, а не каскад: удаление карточки клиента по требованию субъекта
  // не стирает заявку — у неё своё согласие и свой срок хранения.
  clientId String?
  client   Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events CrmEvent[]
  orders Order[]

  @@index([status, createdAt])
  @@index([clientId])
}

// ---------- Клиенты ----------
// Заявка отвечает на вопрос «кто обратился», клиент — «с кем мы работаем».
// Это разные сроки жизни: обращение закрывается, человек остаётся — у него
// адрес, история работ и техника, которую ему поставили (ADR-105).

model Client {
  id   String @id @default(cuid())
  name String

  // Телефон хранится дважды намеренно. `phone` — как его ввели: владелец
  // узнаёт свою запись и диктует номер в привычном виде. `phoneKey` — только
  // цифры, приведённые к коду 7: «+7 (910) 155-24-68» и «8 910 155 24 68» —
  // один и тот же человек, и второй карточки у него быть не должно.
  phone    String
  phoneKey String @unique

  address String?
  note    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  leads  Lead[]
  orders Order[]
  units  ClientUnit[]

  // Список открывают, чтобы найти человека: свежие сверху, поиск по остальным.
  @@index([createdAt])
}

// Техника, которая стоит у клиента. Появляется сама из выполненного монтажа:
// список того, что владелец продал и поставил, — это и история, и повод
// позвонить через год (CRM.md §3.2).
model ClientUnit {
  id       String @id @default(cuid())
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  // Что стоит: модель строкой, как и в позиции наряда. Ставят и технику,
  // купленную клиентом самостоятельно, — такой в каталоге нет.
  model String

  // Когда поставили и до какого числа гарантия. Гарантия отличает
  // гарантийный случай от платного ремонта, поэтому хранится датой, а не
  // сроком: сроки в настройках меняются, а обещание конкретному человеку — нет.
  installedAt   DateTime
  warrantyUntil DateTime?

  // Фотография установки и наряд, из которого техника выросла. `SetNull`:
  // удалённый наряд не отменяет того, что кондиционер у человека висит.
  photo   String?
  orderId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId, installedAt])
}

// ---------- Заказы (наряды) ----------
// Работа с деньгами, датой и исполнителем. Дело в календаре — напоминание
// без денег; монтаж, ТО и ремонт заводятся нарядом (ADR-093).

enum OrderType {
  INSTALL // монтаж
  SERVICE // обслуживание, ТО
  REPAIR // ремонт
}

enum OrderStatus {
  NEW // заведён, исполнитель не назначен
  ASSIGNED // назначен монтажнику
  IN_PROGRESS // монтажник в работе
  DONE // выполнен
  CANCELLED // отказ
}

enum PaymentMode {
  COMPANY // клиент платит компании
  CASH_TO_INSTALLER // наличными монтажнику на объекте
}

// 🔴 Почему отказались — справочник, а не свободная строка (ADR-310).
// Свободным текстом «дорого», «Дорого» и «дороговато» стали бы тремя разными
// причинами, и вкладка «Отказы» перестала бы обобщать хоть что-нибудь.
// Уточнение словами живёт рядом отдельным полем — оно дополняет справочник,
// а не заменяет его.
enum OrderCancelReason {
  CLIENT_REFUSED // клиент отказался
  NO_ANSWER // не дозвонились
  TOO_EXPENSIVE // дорого
  CHOSE_OTHER // выбрал другого подрядчика
  POSTPONED // перенос на потом
  OUR_FAULT // наша ошибка
  OTHER // другое
}

model Order {
  id String @id @default(cuid())

  // Владелец видит номер как «№ 1059» и ждёт непрерывности, поэтому счётчик
  // свой (`Setting.orderSeq`), а не автоинкремент Postgres: тот оставляет
  // дыры на каждой откатанной транзакции.
  number Int         @unique
  type   OrderType
  status OrderStatus @default(NEW)

  // Клиент обязателен: наряд без человека, к которому едут, — это дело в
  // календаре, а не работа. `Restrict`: клиента с историей работ не удаляют
  // молча, сначала разбираются с нарядами.
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Restrict)

  // Исполнитель. `SetNull`: уволенный монтажник исчезает из учётных записей,
  // но выполненный им наряд остаётся в истории клиента.
  installerId String?
  installer   AdminUser? @relation(fields: [installerId], references: [id], onDelete: SetNull)

  // Момент в UTC, показывается в московском — как у дела календаря (ADR-080).
  at DateTime

  // Длительность в минутах, а не в часах: полтора часа на ТО — обычное дело,
  // и загрузка бригад считается по минутам, а не округляется вверх.
  durationMin Int @default(120)

  // Минуты за границей рабочего окна на момент записи — как у дела календаря
  // (ADR-128). Хранится числом, а не считается при показе: окно владелец
  // меняет, а переработка прошлого четверга измениться не имеет права.
  overtimeMin Int @default(0)

  // Объект. Адрес отдельно от адреса клиента: ставят и на даче, и в офисе.
  address     String
  intercom    String?
  phone2      String?
  floor       Int?
  heightWorks Boolean @default(false)

  // Деньги. Суммы целые: копеек на этом рынке не бывает.
  payment      PaymentMode @default(COMPANY)
  price        Int         @default(0)
  installerFee Int         @default(0)

  // 🔴 Не «штраф»: штрафов как вида взыскания в ТК РФ нет, а уменьшение
  // вознаграждения по ГПХ законно только когда прописано в договоре
  // (CRM.md §9). Поле учётное, основание обязательно при ненулевой сумме —
  // проверяет схема Zod, а не база.
  deductionSum    Int     @default(0)
  deductionReason String?

  // Комментарий монтажник видит, заметку владельца — нет. Это разные поля,
  // а не одно с флагом: «не отдавать наружу» должно решаться выбором поля.
  comment   String?
  ownerNote String?

  // ---------- Отказ ----------
  // 🔴 Причина обязательна при переводе в CANCELLED (ADR-310, issue #627):
  // отказ без разбора не даёт ничего, ради чего заводится вкладка «Отказы».
  // Проверяет её схема Zod и репозиторий, а не база: обязательность зависит
  // от статуса, и выразить её ограничением колонки нечем.
  //
  // Все три необязательны — тот же приём, что у отказа отзыва (ADR-300): у
  // наряда, который не отменяли, отказа нет. При возврате в работу поля
  // гасятся, иначе причина читалась бы как действующая.
  cancelReason OrderCancelReason?
  cancelNote   String?
  cancelledAt  DateTime?

  // Обращение, из которого вырос наряд. `SetNull`: удалённая заявка не
  // отменяет работу, о которой уже договорились.
  leadId String?
  lead   Lead?   @relation(fields: [leadId], references: [id], onDelete: SetNull)

  // Итог работ: что сделали сверх наряда и отчёт монтажника. Заполняется по
  // факту, поэтому отдельно от плановых полей — плановую сумму итог не правит.
  extraWork String?
  report    String?
  resultAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  units      OrderUnit[]
  checklist  OrderChecklistItem[]
  docs       OrderDocument[]
  photos     OrderPhoto[]
  history    OrderHistory[]
  stockMoves StockMovement[]

  @@index([status, at])
  @@index([clientId])
  @@index([installerId, at])
  @@index([at])
}

enum OrderEquip {
  CONDITIONER // кондиционер
  FRIDGE // холодильник
  COMPRESSOR // компрессор
  VENTILATION // вентиляция
  HEAT_CURTAIN // тепловая завеса
  OTHER // другое
}

enum UnitSource {
  OURS // наше оборудование: продажа с монтажом
  CLIENT // оборудование клиента: только работы
}

// Позиция оборудования в наряде. Список, а не одно поле: половина заказов —
// монтаж техники, купленной клиентом, и в одном выезде бывает два блока с
// разными условиями (CRM.md §3.3).
model OrderUnit {
  id      String     @id @default(cuid())
  orderId String
  order   Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  equip   OrderEquip @default(CONDITIONER)

  // Модель строкой, а не ссылкой на каталог: ставят и то, что клиент купил
  // сам, — такой техники в каталоге нет и быть не должно.
  model String?

  source UnitSource @default(OURS)

  // Трасса в метрах и диаметр — по ним собирается чеклист выезда и считается
  // смета. Диаметр строкой: пишут «1/4–3/8», а не число.
  trassaM  Int?
  diameter String?
  shtrob   Boolean @default(false)

  sort Int @default(0)

  @@index([orderId, sort])
}

// ---------- Склад ----------

// Набор единиц измерения задаётся кодом, сама номенклатура — справочник в
// базе (инвариант 8): владелец заводит свои позиции сам и не зовёт
// разработчика ради одиннадцатой группы.
enum StockUnit {
  PIECE // штука
  METER // метр
  KILOGRAM // килограмм
  LITER // литр
  PAIR // пара
  PACK // упаковка
  COIL // бухта
  ROLL // моток
  CYLINDER // баллон
}

// Гараж и машины монтажников. «Выдано под наряд» отдельной зоной не стало:
// до списания материал физически лежит в машине, а не в третьем месте
// (ADR-134).
enum StockZoneKind {
  WAREHOUSE
  VAN
}

model StockZone {
  id   String        @id @default(cuid())
  kind StockZoneKind
  name String

  // Машина закреплена за человеком: монтажник видит свою и только свою.
  // `SetNull` — уволенный человек исчезает, а движения его машины остаются:
  // без них не ответить, куда делась трасса.
  userId String?
  user   AdminUser? @relation(fields: [userId], references: [id], onDelete: SetNull)

  sort     Int     @default(0)
  archived Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  movesFrom StockMovement[] @relation("StockMoveFrom")
  movesTo   StockMovement[] @relation("StockMoveTo")

  @@index([archived, kind, sort])
  @@index([userId])
}

model StockItem {
  id   String @id @default(cuid())
  name String

  // Группа справочника строкой: «Медная труба», «Крепёж». Список групп
  // складывается из самих позиций — зашить его в код значит запретить
  // владельцу завести свою.
  group String?
  unit  StockUnit

  // Остаток дробный: фреон меряется килограммами, труба и кабель — метрами,
  // и «полбаллона» — нормальное рабочее состояние. Целое число здесь неверно
  // с первого дня.
  //
  // Порог «пора заказывать» задаётся на позицию, а не общим числом: пять
  // кронштейнов и пять метров трассы — разные степени тревоги. Ноль — за
  // позицией не следим.
  minQty Decimal @default(0) @db.Decimal(12, 3)

  // Техника ссылается на модель каталога, расходники — нет. Ссылка нужна,
  // чтобы знать, чей это кондиционер; витрина от остатка не зависит и
  // моделей из каталога не прячет (ADR-134).
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  note String?

  // Позиция не удаляется, а сдаётся в архив: удаление унесло бы с собой
  // историю движений, ради которой склад и заводится.
  archived Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  movements StockMovement[]

  @@index([archived, group, name])
  @@index([productId])
}

// Приход, перемещение между зонами, списание в наряд, возврат с объекта,
// инвентаризация. Больше видов не нужно: остаток — сумма движений, а не
// редактируемое поле, и правка руками существует как движение с основанием,
// а не как тихое переписывание значения.
enum StockMoveKind {
  INCOME
  TRANSFER
  CONSUME
  RETURN
  COUNT
}

model StockMovement {
  id     String        @id @default(cuid())
  itemId String
  item   StockItem     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  kind   StockMoveKind

  // Количество положительное, направление задают зоны. Исключение —
  // инвентаризация: она и добавляет, и убавляет, поэтому знак у неё свой.
  qty Decimal @db.Decimal(12, 3)

  fromZoneId String?
  fromZone   StockZone? @relation("StockMoveFrom", fields: [fromZoneId], references: [id], onDelete: SetNull)
  toZoneId   String?
  toZone     StockZone? @relation("StockMoveTo", fields: [toZoneId], references: [id], onDelete: SetNull)

  // Наряд, в который списали или из которого вернули. `SetNull`: удалённый
  // наряд не отменяет того, что материал ушёл со склада.
  orderId String?
  order   Order?  @relation(fields: [orderId], references: [id], onDelete: SetNull)

  // Серийные номера ушедшей техники — строкой, как их пишет человек:
  // поштучного учёта экземпляров в первой версии нет (ADR-134).
  serials String?

  // Списание, которое отменяет этот возврат. Уникально намеренно: отменить
  // одно списание дважды нельзя, и запрещает это база, а не проверка перед
  // записью — между ней и вставкой успевает пройти второй такой же запрос.
  cancelsId String? @unique

  // Основание. У инвентаризации обязательно — иначе расхождение остаётся
  // без объяснения ровно там, где объяснение и нужно.
  reason String?

  // `SetNull`: журнал переживает увольнение автора движения.
  authorId String?
  author   AdminUser? @relation(fields: [authorId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([itemId, createdAt])
  @@index([orderId])
  @@index([createdAt])
}

// ---------- Календарь работ ----------
// Заявка говорит, что человек обратился. Календарь — что с ним происходит
// дальше: когда выехали на замер, когда монтаж, когда перезвонить.

enum CrmEventKind {
  CALL // позвонить
  MEASURE // выезд на замер
  INSTALL // монтаж
  SERVICE // обслуживание, чистка
  MEETING // встреча
  NOTE // прочее: то, что просто нужно помнить в этот день
}

enum CrmEventStatus {
  PLANNED
  DONE
  CANCELLED
}

model CrmEvent {
  id     String         @id @default(cuid())
  kind   CrmEventKind
  status CrmEventStatus @default(PLANNED)

  // Момент времени в UTC. Владелец вводит и видит московское время: часовой
  // пояс дела задаёт город работ, а не настройки браузера у того, кто смотрит.
  at DateTime

  // Сколько дело занимает. Без длительности его нечем нарисовать на часовой
  // сетке: «занято с 11 до 20» — это отрезок, а не точка (ADR-128). Час по
  // умолчанию: столько идёт обычный замер или звонок.
  durationMin Int @default(60)

  // Минуты за границей рабочего окна на момент записи. Считается при
  // сохранении и хранится числом, а не выводится при показе: окно в
  // настройках владелец меняет, а переработка, уже случившаяся в четверг,
  // от этого измениться не имеет права — на неё смотрят при расчётах.
  overtimeMin Int @default(0)

  // Клиент вписывается строками, а не ссылкой на заявку: половина работ
  // приходит по звонку и сарафану, и такое дело обязано попадать в календарь
  // без выдуманной заявки на сайте.
  clientName  String
  clientPhone String?
  address     String?
  note        String?

  // Заявка, из которой выросло дело. `SetNull`, а не каскад: удалённая заявка
  // не отменяет монтаж, о котором уже договорились с человеком.
  leadId String?
  lead   Lead?   @relation(fields: [leadId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([at])
  @@index([leadId])
}

// Чеклист выезда: «что взять с собой». Собирается из данных наряда, но
// хранится записями — монтажник дописывает своё и отмечает при сборах, и
// пересборка не должна стирать его пометки.
model OrderChecklistItem {
  id      String  @id @default(cuid())
  orderId String
  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  text    String
  done    Boolean @default(false)

  // Пункт добавлен человеком, а не собран из наряда: пересборка его сохраняет.
  own  Boolean @default(false)
  sort Int     @default(0)

  @@index([orderId, sort])
}

enum OrderDocKind {
  CONTRACT // договор
  WARRANTY // гарантийный талон
  ACT // акт выполненных работ
  INVOICE // счёт
  MEASURE // замерный лист
  OTHER
}

// 🔴 Документы наряда — договоры с персональными данными. Публичный
// `/api/media/{name}` для них не годится: он открыт. Файл отдаётся маршрутом,
// который сверяет сессию и принадлежность документа наряду, доступному
// смотрящему (CRM.md §9).
model OrderDocument {
  id        String       @id @default(cuid())
  orderId   String
  order     Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  kind      OrderDocKind @default(OTHER)
  // Имя, показываемое человеку. Имя файла на диске генерирует сервер:
  // оригинальное не используется никогда (docs/CLAUDE.md, «Безопасность»).
  name      String
  url       String
  sizeBytes Int
  createdAt DateTime     @default(now())

  @@index([orderId, createdAt])
}

enum PhotoStage {
  BEFORE // место установки до выезда: снимает владелец, смотрит монтажник
  AFTER // выполненные работы: снимает монтажник, остаётся в истории клиента
}

model OrderPhoto {
  id      String     @id @default(cuid())
  orderId String
  order   Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  stage   PhotoStage
  url     String
  sort    Int        @default(0)

  @@index([orderId, stage, sort])
}

// История наряда: кто и когда менял статус, кого назначили, когда заполнили
// итог. `SetNull` у автора: уволенный монтажник исчезает, запись остаётся —
// иначе история наряда теряет смысл ровно тогда, когда в неё смотрят.
model OrderHistory {
  id        String     @id @default(cuid())
  orderId   String
  order     Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  authorId  String?
  author    AdminUser? @relation(fields: [authorId], references: [id], onDelete: SetNull)
  text      String
  createdAt DateTime   @default(now())

  @@index([orderId, createdAt])
}

// ---------- Занятость ----------
// Календарь показывает, что запланировано. Занятость отвечает на обратный
// вопрос: когда человека нет. Пустой день выглядит свободным, и в него
// ставят выезд — поэтому «меня нет» должно быть записью, а не памятью.

enum BlockRepeat {
  ONCE // конкретная дата
  WEEKLY // каждую такую-то неделю: постоянный выходной
}

model DayBlock {
  id String @id @default(cuid())

  // 🔴 Занятость личная: у каждого свои дела, и общий на компанию выходной
  // пришлось бы переделывать, как только монтажников станет двое. Владелец
  // видит занятость всех, монтажник — свою.
  userId String
  user   AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  repeat BlockRepeat @default(ONCE)

  // Разовая занятость: календарная дата, полночь по Москве в UTC. У
  // повторяемой пусто.
  day DateTime?

  // Повторяемая: день недели, 1 — понедельник … 7 — воскресенье (ISO-8601).
  // У разовой пусто.
  weekday Int?

  // Окно занятости в минутах от полуночи по московскому времени. Оба пусты —
  // занят весь день. Диапазон нужен не для красоты: запись к врачу на два
  // часа не должна закрывать день целиком, иначе владелец перестанет её
  // ставить и вернётся к памяти.
  fromMin Int?
  toMin   Int?

  reason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, day])
  @@index([userId, repeat])
}

// ---------- Очередь уведомлений ----------
// Заявка сначала попадает в БД, уведомление — отдельная сущность с ретраями.

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

model Notification {
  id      String @id @default(cuid())
  channel String // «email» | «telegram»
  kind    String // «lead» | «review» | «to-reminder» | «order-assigned» | …
  payload Json

  // Кому уходит сообщение. `null` — владельцу компании по общим настройкам:
  // так уходили все уведомления до появления адресации, и такими остаются
  // заявка, отзыв и напоминание о ТО. Заполнено — адресату лично.
  //
  // `SetNull`: уволенный монтажник исчезает, а журнал доставки остаётся —
  // по нему разбираются, дошло ли до человека сообщение о наряде.
  recipientId String?
  recipient   AdminUser? @relation(fields: [recipientId], references: [id], onDelete: SetNull)

  // Адрес, по которому сообщение ушло на самом деле. Снимок, а не ссылка:
  // человек меняет чат и почту, и журнал обязан показывать, куда доставляли
  // тогда, а не куда доставили бы сейчас.
  address String?

  status    NotificationStatus @default(PENDING)
  attempts  Int                @default(0)
  lastError String?
  nextTryAt DateTime           @default(now())
  createdAt DateTime           @default(now())
  sentAt    DateTime?

  @@index([status, nextTryAt])
  @@index([recipientId, createdAt])
}

// ---------- Админка ----------

// Ролей две, и обе — люди с логином и паролем: монтажник заходит в ту же
// панель, просто видит из неё три раздела вместо тринадцати (ADR-092).
enum AdminRole {
  OWNER
  INSTALLER
}

// Как оформлены отношения с человеком. От этого зависит, чем является
// удержание в наряде: у самозанятого и подрядчика по ГПХ это законное
// уменьшение вознаграждения, когда оно прописано в договоре; у работника по
// трудовому договору штрафов как взыскания в ТК РФ нет вовсе, и запись
// остаётся внутренней пометкой о браке или срыве (CRM.md §9).
enum Employment {
  SELF_EMPLOYED // самозанятый
  CONTRACT // договор ГПХ
  STAFF // трудовой договор
}

model AdminUser {
  id           String    @id @default(cuid())
  login        String    @unique
  passwordHash String
  role         AdminRole @default(OWNER)

  // Необязательно: у владельца оформления нет, а у монтажника оно может быть
  // ещё не заведено. Выдумывать его нельзя — от него зависят деньги.
  employment Employment?

  // ИНН монтажника. Нужен, чтобы проверить статус самозанятого: он слетает при
  // превышении лимита дохода или снятии с учёта, и на дату выплаты может быть
  // уже не тот, а у ФНС проверка идёт по ИНН и дате (PROJECT §5.4).
  //
  // 🔴 Персональные данные работника, и единственные сверх оформления, которые
  // мы держим: паспорт, СНИЛС, адрес и сканы — кадровый учёт бухгалтера, а не
  // этой системы (PROJECT §5.5). Наружу не выходит никогда: публично
  // оформление монтажника не показывается вовсе.
  //
  // Необязательный: человека заводят по телефону, а ИНН узнают позже —
  // блокировать заведение из-за незаполненного поля нельзя.
  inn String?

  // Адреса доставки уведомлений — личные. До них адрес был один на компанию,
  // и разослать «каждому своё» было физически некуда.
  //
  // Chat ID телеграма человек не знает и узнать сам не может: его выдаёт
  // привязка через бота, а не поле для ввода. Почта вводится руками.
  telegramChatId String?
  email          String?

  // Имя и телефон нужны в наряде и в списке команды. Необязательные: у учётной
  // записи владельца, заведённой сидом, имени может не быть, и выдумывать его
  // нельзя — интерфейс покажет логин.
  name  String?
  phone String?

  // Отключение закрывает вход, но сохраняет историю: выполненные наряды
  // остаются за человеком, даже когда он больше не работает.
  active Boolean @default(true)

  createdAt   DateTime  @default(now())
  lastLoginAt DateTime?

  sessions        Session[]
  notes           InstallerNote[]
  orders          Order[]
  blocks          DayBlock[]
  notifications   Notification[]
  orderHistory    OrderHistory[]
  stockZones      StockZone[]
  stockMoves      StockMovement[]
  rejectedReviews Review[]        @relation("ReviewRejectedBy")

  @@index([role, active])
}

// Заметки владельца о монтажнике. Сам монтажник их не видит — поэтому это
// отдельная таблица, а не поле в `AdminUser`: так «не отдавать наружу» —
// решение о том, присоединять ли связь, а не о том, вырезать ли поле.
model InstallerNote {
  id        String    @id @default(cuid())
  userId    String
  text      String
  createdAt DateTime  @default(now())
  user      AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model Session {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  createdAt DateTime  @default(now())
  user      AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

// ---------- Антиспам ----------

model RateLimit {
  id       String   @id @default(cuid())
  key      String // ip + endpoint
  windowAt DateTime
  hits     Int      @default(1)

  @@unique([key, windowAt])
  // чистка отработавших окон идёт диапазоном по времени — составной
  // уникальный индекс по [key, windowAt] такой запрос не обслуживает
  @@index([windowAt])
}
