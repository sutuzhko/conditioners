{
  // Проверка типизированных маршрутов без сборки (issue #883).
  //
  // Те же исходники, что у основного `typecheck`, но вместо `.next/types`
  // подставляется копия контракта из `types/routes-contract.d.ts`. Смысл в
  // том, чтобы `Route` был настоящим в любом рабочем дереве — собранном или
  // нет: без `.next` Next отдаёт заглушку `Route = string & {}`, и целый
  // класс ошибок не виден вовсе (ADR-147).
  //
  // 🔴 `next-env.d.ts` сюда не входит намеренно: он тянет
  // `./.next/types/routes.d.ts`, то есть ровно ту зависимость от сборки, от
  // которой проверка уходит. Нужные ему ссылки на типы Next стоят в самой
  // копии контракта.
  //
  // 🔴 Двух объявлений модуля `next` в одной программе быть не может: копия
  // и `.next/types/link.d.ts` объявляют его оба. Поэтому `.next` исключён
  // здесь, а копия — в основном `tsconfig.json`.
  "extends": "./tsconfig.json",
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": ["node_modules", ".next", "next-env.d.ts"],
  "compilerOptions": {
    // Свой файл истории сборки: делить его с основной проверкой нельзя —
    // состав программ разный, и они затирали бы кеш друг друга.
    "tsBuildInfoFile": "./tsconfig.routes.tsbuildinfo"
  }
}
