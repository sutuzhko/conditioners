# Боевой прокси. Дев-версия — Caddyfile.dev; общие заголовки безопасности
# живут в Caddyfile.headers и подключаются в обоих окружениях.
{
	admin off
	# Адрес для писем Let's Encrypt об истечении сертификата
	email {$ACME_EMAIL}
	servers {
		# Медленный клиент не должен держать соединение вечно (slowloris):
		# заголовки — быстро, тело — щедро (фото в форме идёт с телефона)
		timeouts {
			read_header 10s
			read_body 60s
			idle 5m
		}
	}
}

import Caddyfile.headers

# Канонический хост. Всё, что пришло на www или по http, приводится к нему
# 301-м редиректом: два адреса одной страницы — это дубли в выдаче.
www.{$SITE_DOMAIN} {
	redir https://{$SITE_DOMAIN}{uri} permanent
}

{$SITE_DOMAIN} {
	encode zstd gzip

	import security_headers
	header {
		# Сертификат уже выдан, откат на http не нужен. Только в проде:
		# в деве HSTS запер бы браузер на https для локальных хостов.
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
	}

	# Приложение и так режет загрузки своим лимитом, но тело обязано быть
	# отброшено до буферизации в Node, а не после (аудит, BUGS).
	request_body {
		max_size 12MB
	}

	# Слэш в конце — второй адрес той же страницы. Убираем его до приложения.
	# Query сохраняется: рекламные метки и ?category= не должны пропадать на
	# редиректе (аудит, BUGS) — отсюда два матчера, с параметрами и без.
	@slash_with_query {
		path_regexp trailingq (.+)/$
		expression {query} != ""
	}
	redir @slash_with_query https://{$SITE_DOMAIN}{re.trailingq.1}?{query} permanent

	@slash_bare {
		path_regexp trailing (.+)/$
		expression {query} == ""
	}
	redir @slash_bare https://{$SITE_DOMAIN}{re.trailing.1} permanent

	reverse_proxy web:3000 {
		# Приложение считает частоту запросов по IP клиента, а не по адресу
		# прокси: заголовки ставит Caddy, но пусть это будет видно в конфиге.
		header_up X-Real-IP {remote_host}
	}
}
