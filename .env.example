# Дев-окружение. Копируется в .env.dev и используется docker-compose.dev.yml.
# Боевые значения — в .env.prod (шаблон: .env.prod.example).
# Разработка ведётся только в Docker, см. docs/DEPLOY.md §2.

# ===== Базовые образы =====
# По умолчанию Docker Hub. Если демон Docker не может достучаться до CDN Docker Hub
# (типично при VPN со split-DNS — хост резолвит, демон нет), подставь зеркало:
#   NODE_IMAGE=mirror.gcr.io/library/node:22-alpine
#   POSTGRES_IMAGE=mirror.gcr.io/library/postgres:16-alpine
#   CADDY_IMAGE=mirror.gcr.io/library/caddy:2.8-alpine
# Значения читает docker compose, поэтому они должны лежать в .env, а не в .env.dev

NODE_ENV=development
SITE_URL=https://tulaklimat.localhost

# ========= База данных =========
# Хост — имя сервиса compose, не localhost: приложение живёт в контейнере
DATABASE_URL=postgresql://tk:devpass@db:5432/tulaklimat?schema=public
POSTGRES_USER=tk
POSTGRES_PASSWORD=devpass
POSTGRES_DB=tulaklimat

# ========= Админка =========
SESSION_SECRET=dev-secret-not-for-production
ADMIN_LOGIN=admin
# Хеш пароля «admin» — только для дева
ADMIN_PASSWORD_HASH=CHANGE_ME

# ========= Файлы =========
UPLOADS_DIR=/data/uploads
UPLOAD_MAX_BYTES=5242880

# ========= Уведомления =========
# В деве оба канала пишут в лог, а не шлют реальные сообщения владельцу.
# Никогда не подставлять сюда боевой токен бота или боевой SMTP.
NOTIFY_DRIVER=log
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
NOTIFY_EMAIL_TO=

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_TRANSPORT=off
TELEGRAM_PROXY_URL=
TELEGRAM_WEBHOOK_SECRET=dev-webhook-secret

