# Боевые значения. Дев-шаблон — .env.example
# Данные компании (название, телефон, адрес, реквизиты) ЗДЕСЬ НЕ ХРАНЯТСЯ —
# они правятся владельцем в админке, раздел «Компания» (ADR-009).

# ========= Приложение =========
NODE_ENV=production
# Канонический адрес: из него строятся каноникалы, sitemap, OG и ссылки в письмах
SITE_URL=https://example.ru

# ========= Caddy =========
# Домен без схемы: Caddy выпустит на него сертификат, а www отправит редиректом
SITE_DOMAIN=example.ru
# Адрес для писем Let's Encrypt об истечении сертификата
ACME_EMAIL=admin@example.ru

# ========= База данных =========
DATABASE_URL=postgresql://tk:CHANGE_ME@db:5432/tulaklimat?schema=public
# Тот же пароль, но адрес для сборки образа: она идёт вне сети compose и видит
# базу через порт, опубликованный на петле сервера (ADR-062)
BUILD_DATABASE_URL=postgresql://tk:CHANGE_ME@127.0.0.1:5432/tulaklimat?schema=public
POSTGRES_USER=tk
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=tulaklimat

# ========= Админка =========
# Подпись cookie-сессии: openssl rand -base64 48
SESSION_SECRET=CHANGE_ME
ADMIN_LOGIN=admin
# Argon2id-хеш пароля, не сам пароль
ADMIN_PASSWORD_HASH=CHANGE_ME

# ========= Файлы =========
UPLOADS_DIR=/data/uploads
UPLOAD_MAX_BYTES=5242880

# ========= Уведомления =========
# 🔴 Режим доставки. `log` — письма и сообщения только пишутся в журнал и
# никуда не уходят (значение по умолчанию, удобно в разработке). На боевом
# сервере обязателен `live`, иначе владелец не получит ни одного уведомления
# о заявке, а в журнале доставки всё будет выглядеть отправленным.
NOTIFY_DRIVER=live

# ========= Почта (основной канал уведомлений) =========
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_USER=zayavki@example.ru
SMTP_PASSWORD=CHANGE_ME
SMTP_FROM="ТулаКлимат <zayavki@example.ru>"
NOTIFY_EMAIL_TO=owner@example.ru

# ========= Telegram =========
# ВНИМАНИЕ: токен только на сервере. Никогда не NEXT_PUBLIC_ и никогда в клиентский код.
# Токен из дизайн-прототипа скомпрометирован — нужен новый из BotFather.
TELEGRAM_BOT_TOKEN=CHANGE_ME
TELEGRAM_CHAT_ID=CHANGE_ME
# direct — прямой вызов api.telegram.org (проверить с самого VPS, см. docs/DEPLOY.md §5)
# proxy  — через зарубежный SOCKS5/HTTP-прокси
# off    — канал выключен, работает только email
TELEGRAM_TRANSPORT=off
TELEGRAM_PROXY_URL=
# Секрет для проверки входящих апдейтов: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=CHANGE_ME

# ========= Аналитика =========
# Единственная переменная, попадающая на клиент
NEXT_PUBLIC_YANDEX_METRIKA_ID=
