# ===== Секреты =====
# Разрешены только шаблоны: .env.example, .env.prod.example и .env.local.example
.env
.env.*
# 🔴 Образцы окружения — часть документации, а не секрет. Правило `.env.*`
# выше прячет и их, поэтому каждый образец возвращается явно: без этого
# следующий разработчик не узнает, какие переменные нужны, иначе как из кода.
!.env.example
!.env.prod.example
!apps/web/.env.local.example
*.pem
*.key
*.p12
*.pfx
secrets/
.htpasswd

# ===== Дизайн-исходники =====
# Макеты лежат в репозитории: по ним ведётся реализация, и вне репозитория
# они расходятся с кодом молча. Игнорируются только два ранних прототипа —
# в них зашит действующий токен Telegram-бота, а git ничего не забывает.
design/Кондиционеры Тула.dc.html
design/Кондиционеры Тула v2.dc.html

# Превью досок — локальная подсобка для просмотра в браузере: пересобираются
# из `.body.html` одной командой `preview.sh` и версионировать их незачем.
design/**/preview-*.html

# ===== Зависимости и сборка =====
node_modules/
.pnpm-store/
.pnp
.pnp.js
.next/
out/
build/
dist/
*.tsbuildinfo
next-env.d.ts
# Собранная витрина компонентов: артефакт сборки, живёт минуту в CI
storybook-static/

# ===== Данные и загрузки =====
# 🔴 Якорь обязателен. Правило вида `uploads/` без слеша в начале игнорирует
# любой каталог с таким именем на любой глубине — включая исходники маршрутов
# (apps/web/src/app/api/uploads/**). Такой файл не попадёт в коммит молча.
/data/
/uploads/
/pgdata/
apps/web/public/uploads/
*.sql
*.dump
backups/

# 🔴 Исключение из `*.sql`: миграции Prisma — это исходный код схемы, а не
# дамп базы. Без них `prisma migrate deploy` на боевом сервере не находит,
# что накатывать, и база остаётся на схеме первого запуска.
!apps/web/prisma/migrations/**/*.sql

# ===== Тесты и отчёты =====
coverage/
.nyc_output/
playwright-report/
test-results/
# снимки для просмотра вёрстки (ADR-103): черновые кадры, а не эталоны
apps/web/.screenshots/
blob-report/
.playwright/
# снимки Playwright MCP: рабочие кадры сессии, а не артефакт проекта
.playwright-mcp/

# ===== Логи =====
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ===== Окружение разработчика =====
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*~
.claude/settings.local.json

# Замок планировщика Claude Code: pid и id сессии живой машины. Файл рабочего
# состояния, а не конфигурации, — в репозитории он значит ровно ничего.
.claude/scheduled_tasks.lock

# 🔴 Скиллы (`.agents/`) и симлинки на них (`.claude/skills/`) отслеживаются
# сознательно — решение владельца от 28 августа, ADR-149. Не добавлять сюда:
# CLAUDE.md ссылается на `ui-ux-pro-max`, `vercel-react-best-practices` и
# `nestjs-best-practices` как на обязательные, и правило, которое нельзя
# прочитать после клонирования, — не правило.

# Каталог загрузок хостового режима: те же файлы, что в томе контейнера,
# только на диске машины (docs/DEPLOY.md §2)
apps/web/.data/

# ===== Прочее =====
.cache/
.turbo/
.vercel

# 🔴 Эталоны визуальной регрессии в репозитории лежат сознательно (ADR-168):
# правка вёрстки меняет их тем же коммитом, и изменение внешнего вида видно в
# диффе. Молча перегенерировать эталоны больше нельзя — это будет видно.
# Здесь исключается только вывод прогона: расхождения и отчёты.
apps/web/test-results/
apps/web/playwright-report/
