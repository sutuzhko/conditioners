. ./_tabs.sh
T="Наряд|Расход|Чеклист|Документы|История"
cat <<EOF
<div class="board touch">
  <div>
    <span class="note">— Наряд № 128 —</span>
    <h2 style="font-family:var(--font-display);font-size:26px;font-weight:600;margin-top:8px;color:var(--ink)">Пять вкладок на трёх ширинах</h2>
    <p style="margin-top:8px;font-size:14px;color:var(--muted);max-width:1100px">Каждая вкладка нарисована на 1440, 768 и 390. Правило перехода одно на все: колонки, которые нельзя сжать честно, уходят в подпись строки или в меню; таблица на 390 становится карточками; действие прижимается к низу экрана.</p>
  </div>

  <!-- ══ 1. НАРЯД ══ -->
  <div class="tsec">
$(tsec "Вкладка 1" "Наряд" "Данные выезда: объект, оборудование списком позиций, итог работ. Для владельца в правке, для монтажника на чтение.")
    <div class="row3">
      <div class="col"><span class="devlab">1440</span>
        <div class="frame dk">
$(trow "$T" 1)
          <div class="bd20 grid" style="grid-template-columns:minmax(0,1fr) 330px;gap:14px;align-items:start">
            <div class="stack" style="gap:12px">
              <div class="card"><div class="hd"><span class="ttl">Объект</span><span class="btn light sm">На карте $I_CHEV</span></div>
                <div class="bd grid" style="grid-template-columns:2fr 1fr 1fr;gap:10px">
                  <div class="inp bordered col"><span class="lab">Адрес</span><span class="val">Тула, Оборонная 12, кв. 34</span></div>
                  <div class="inp bordered col"><span class="lab">Подъезд · домофон</span><span class="val mono">2 · 34К</span></div>
                  <div class="inp bordered col"><span class="lab">Этаж</span><span class="val">5 из 9</span></div>
                </div></div>
              <div class="card"><div class="hd"><span class="ttl">Оборудование</span><span class="btn flat sm">$I_PLUS Позиция</span></div>
                <div class="bd" style="padding:0"><table class="tbl">
                  <thead><tr><th>Тип и модель</th><th style="width:100px">Чьё</th><th style="width:90px">Трасса</th><th style="width:110px">Диаметр</th><th style="width:110px">Штробление</th></tr></thead>
                  <tbody>
                    <tr><td class="strong">Сплит-система 09, инверторная</td><td><span class="chip c-primary">Наше</span></td><td class="mono">4,5 м</td><td class="mono">1/4″+3/8″</td><td><span class="chip c-warn">Есть · 2 м</span></td></tr>
                    <tr><td class="strong">Ballu BSW-07HN1</td><td><span class="chip c-default">Клиента</span></td><td class="mono">3 м</td><td class="mono">1/4″</td><td><span class="chip c-default">Нет</span></td></tr>
                  </tbody></table></div></div>
              <div class="card"><div class="hd"><span class="ttl">Итог работ</span><span class="chip c-warn">Заполняет монтажник</span></div>
                <div class="bd"><div class="inp flat col tall"><span class="lab">Доп. работы и материалы по факту</span><span class="val ph" style="margin-top:4px">Появится, когда монтажник закроет выезд</span></div></div></div>
            </div>
            <div class="stack" style="gap:12px">
              <div class="card"><div class="hd"><span class="ttl">Когда и кто</span></div>
                <div class="bd stack" style="gap:10px">
                  <div class="inp flat col"><span class="lab">Дата и время</span><span class="val mono">29 августа, 14:00 · 3 ч</span></div>
                  <div class="inp flat" style="justify-content:space-between"><span class="row" style="gap:10px"><span class="ava">ПК</span><span class="body"><span class="lab">Монтажник</span><span class="val">Пётр Кузнецов</span></span></span>$I_DOWN</div>
                </div></div>
              <div class="card"><div class="hd"><span class="ttl">Деньги</span><span class="chip c-default">Скрыто</span></div>
                <div class="bd stack" style="gap:8px">
                  <div class="row" style="justify-content:space-between"><span class="t-lbl mut">Сумма</span><span class="num" style="font-size:18px">34 900 ₽</span></div>
                  <div class="row" style="justify-content:space-between"><span class="t-lbl mut">Выплата</span><span class="mono strong">6 000 ₽</span></div>
                  <div class="row" style="justify-content:space-between"><span class="t-lbl strong">Остаётся</span><span class="num" style="font-size:16px;color:var(--ok-ink)">28 900 ₽</span></div>
                </div></div>
            </div>
          </div>
        </div></div>
      <div class="col"><span class="devlab">768</span>
        <div class="frame tb">
$(trow "$T" 1 sm)
          <div class="bd16 stack" style="gap:12px">
            <div class="card"><div class="hd"><span class="ttl">Объект</span></div>
              <div class="bd grid" style="grid-template-columns:1fr 1fr;gap:10px">
                <div class="inp bordered col" style="grid-column:span 2"><span class="lab">Адрес</span><span class="val">Тула, Оборонная 12, кв. 34</span></div>
                <div class="inp bordered col"><span class="lab">Подъезд · домофон</span><span class="val mono">2 · 34К</span></div>
                <div class="inp bordered col"><span class="lab">Этаж</span><span class="val">5 из 9</span></div>
              </div></div>
            <div class="card"><div class="hd"><span class="ttl">Оборудование</span><span class="btn flat sm">$I_PLUS</span></div>
              <div class="bd stack" style="gap:8px">
                <div class="card flat" style="border-color:var(--line)"><div class="bd stack" style="gap:6px;padding:11px"><span class="strong">Сплит-система 09, инверторная</span><span class="row" style="gap:6px;flex-wrap:wrap"><span class="chip c-primary">Наше</span><span class="chip c-default">4,5 м</span><span class="chip c-warn">Штроба 2 м</span></span></div></div>
                <div class="card flat" style="border-color:var(--line)"><div class="bd stack" style="gap:6px;padding:11px"><span class="strong">Ballu BSW-07HN1</span><span class="row" style="gap:6px;flex-wrap:wrap"><span class="chip c-default">Клиента</span><span class="chip c-default">3 м</span></span></div></div>
              </div></div>
            <div class="grid" style="grid-template-columns:1fr 1fr;gap:10px;align-items:start">
              <div class="card"><div class="hd"><span class="ttl">Когда и кто</span></div><div class="bd stack" style="gap:8px"><span class="mono t-lbl strong">29 авг, 14:00 · 3 ч</span><span class="usr"><span class="ava xs">ПК</span><span class="nm" style="font-size:13px">Пётр Кузнецов</span></span></div></div>
              <div class="card"><div class="hd"><span class="ttl">Деньги</span></div><div class="bd stack" style="gap:6px"><span class="row" style="justify-content:space-between"><span class="t-lbl mut">Сумма</span><span class="mono strong">34 900 ₽</span></span><span class="row" style="justify-content:space-between"><span class="t-lbl strong">Остаётся</span><span class="mono strong" style="color:var(--ok-ink)">28 900 ₽</span></span></div></div>
            </div>
          </div>
        </div></div>
      <div class="col"><span class="devlab">390</span>
        <div class="frame ph" style="min-height:700px">
          <div class="mbar"><span class="row" style="gap:10px"><span class="iconbtn"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="m15 6-6 6 6 6"/></svg></span><span class="mtitle">Заказ № 128</span></span><span class="chip c-primary"><span class="dot"></span>В работе</span></div>
$(trow "$T" 1 xs)
          <div class="mbody">
            <div class="card"><div class="mrow" style="gap:8px"><span class="cap" style="margin:0">Объект</span><span class="strong">Тула, Оборонная 12, кв. 34</span><span class="row" style="gap:12px"><span class="t-tiny mut">Подъезд <b class="mono ink">2</b></span><span class="t-tiny mut">Домофон <b class="mono ink">34К</b></span><span class="t-tiny mut">Этаж <b class="mono ink">5</b></span></span><div class="row" style="gap:8px"><span class="btn flat" style="flex:1">Маршрут</span><span class="btn flat" style="flex:1">Позвонить</span></div></div></div>
            <div class="card"><div class="mrow" style="gap:8px"><span class="cap" style="margin:0">Что ставим</span>
              <span class="strong">Сплит-система 09, инверторная</span><span class="row" style="gap:6px;flex-wrap:wrap"><span class="chip c-primary">Наше</span><span class="chip c-default">4,5 м</span><span class="chip c-warn">Штроба</span></span>
              <hr class="hr"><span class="strong">Ballu BSW-07HN1</span><span class="row" style="gap:6px"><span class="chip c-default">Клиента</span><span class="chip c-default">3 м</span></span></div></div>
            <div class="card"><div class="mrow" style="gap:6px"><span class="row" style="justify-content:space-between"><span class="t-lbl mut">Сумма заказа</span><span class="num" style="font-size:18px">34 900 ₽</span></span><span class="row" style="justify-content:space-between"><span class="t-lbl strong">Остаётся</span><span class="mono strong" style="color:var(--ok-ink)">28 900 ₽</span></span></div></div>
          </div>
          <div class="sticky-act"><span class="btn solid lg" style="width:100%">$I_CHECK Отметить выполненным</span></div>
        </div></div>
    </div>
    <span class="devcap">768 — правая колонка уезжает вниз двумя карточками, оборудование становится карточками. 390 — вкладки лентой с затуханием, три блока подряд, действие внизу.</span>
  </div>
</div>
EOF
