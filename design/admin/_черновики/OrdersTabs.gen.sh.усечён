. ./_tabs.sh
T="Активные 7|Новые 2|История|Отказы|Все 24"
# строка таблицы заказа для 1440
r1440() { printf '<tr><td class="mono strong">%s</td><td><div class="strong">%s</div><div class="t-tiny mut clip">%s</div></td><td>%s</td><td class="mono t-lbl">%s</td><td>%s</td><td class="rt mono strong">%s</td></tr>' "$1" "$2" "$3" "$4" "$5" "$6" "$7"; }
head3() { printf '<div class="col"><span class="devlab">%s</span>' "$1"; }
cat <<EOF
<div class="board touch">
  <div>
    <span class="note">— Заказы —</span>
    <h2 style="font-family:var(--font-display);font-size:26px;font-weight:600;margin-top:8px;color:var(--ink)">Пять вкладок списка на трёх ширинах</h2>
    <p style="margin-top:8px;font-size:14px;color:var(--muted);max-width:1100px">Вкладка меняет не только фильтр, но и состав колонок: у истории появляются маржа и отзыв, у отказов — причина. Счётчики в подписях вкладок приходят из данных.</p>
  </div>

  <!-- 1. АКТИВНЫЕ -->
  <div class="tsec">
$(tsec "Вкладка 1" "Активные" "Умолчание раздела: заказы, по которым идёт работа. Просроченный виден краснотой в дате и статусе — двумя признаками, не одним.")
    <div class="row3">
$(head3 1440)
        <div class="frame dk">
$(trow "$T" 1)
