            <div class="tbar" style="margin-bottom:12px">
              <div class="row" style="gap:8px"><span class="btn faded sm">$I_FILT Фильтр <span class="chip c-primary" style="height:17px;padding:0 5px">2</span></span><span class="btn faded sm">$I_SORT Сортировка</span><span class="chip c-primary lg">Этот месяц <span class="x">×</span></span></div>
              <span class="inp faded md solo" style="width:260px"><span class="ico">$I_SEARCH</span><span class="body"><span class="val ph clip">Номер, клиент, адрес</span></span></span>
            </div>
            <div class="card"><div class="bd" style="padding:0"><table class="tbl">
              <thead><tr><th style="width:76px">Номер</th><th>Клиент и объект</th><th style="width:170px">Монтажник</th><th style="width:120px">Когда</th><th style="width:130px">Статус</th><th class="rt" style="width:110px">Сумма</th></tr></thead>
              <tbody>
$(r1440 "№ 128" "Дмитрий Лапшин" "Тула, Оборонная 12, кв. 34" '<span class="usr"><span class="ava xs">ПК</span><span class="nm" style="font-size:13px">Пётр Кузнецов</span></span>' "29 авг, 14:00" '<span class="chip c-primary"><span class="dot"></span>В работе</span>' "34 900 ₽")
$(r1440 "№ 127" "ООО «Тулаторг»" "Тула, пр. Ленина 108, офис 312" '<span class="usr"><span class="ava xs" style="background:var(--info-bg);color:var(--info-ink)">АМ</span><span class="nm" style="font-size:13px">Артём Морозов</span></span>' "29 авг, 17:30" '<span class="chip c-warn"><span class="dot"></span>Назначен</span>' "8 400 ₽")
$(r1440 "№ 125" "Владислав Гринёв" "Тула, Металлургов 22, кв. 108" '<span class="usr"><span class="ava xs" style="background:var(--ok-bg);color:var(--ok-ink)">ИС</span><span class="nm" style="font-size:13px">Иван Соколов</span></span>' "31 авг, 09:00" '<span class="chip c-danger"><span class="dot"></span>Просрочен</span>' "12 000 ₽")
$(r1440 "№ 124" "Николай" "Новомосковск, Мира 7, кв. 12" '<span class="usr"><span class="ava xs" style="background:var(--ok-bg);color:var(--ok-ink)">ИС</span><span class="nm" style="font-size:13px">Иван Соколов</span></span>' "2 сен, 11:00" '<span class="chip c-warn"><span class="dot"></span>Назначен</span>' "27 400 ₽")
              </tbody></table></div>
              <div class="pager" style="border-top:1px solid var(--line)"><span class="t-lbl mut">4 из 7</span><span class="pg"><span class="dis">‹</span><span class="on">1</span><span>›</span></span><span class="row t-lbl mut" style="gap:8px">Строк <span class="btn bord sm">8 $I_DOWN</span></span></div>
            </div>
          </div>
        </div></div>
$(head3 768)
        <div class="frame tb">
$(trow "$T" 1 sm)
          <div class="bd16">
            <div class="tbar" style="margin-bottom:10px"><span class="inp faded md solo" style="flex:1;min-width:0"><span class="ico">$I_SEARCH</span><span class="body"><span class="val ph clip">Номер, клиент</span></span></span><span class="btn faded sm">$I_FILT Фильтр <span class="chip c-primary" style="height:17px;padding:0 5px">2</span></span></div>
            <div class="card"><div class="bd" style="padding:0"><table class="tbl">
              <thead><tr><th style="width:70px">Номер</th><th>Клиент и объект</th><th style="width:100px">Когда</th><th style="width:120px">Статус</th></tr></thead>
              <tbody>
                <tr><td class="mono strong">№ 128</td><td><div class="strong">Дмитрий Лапшин</div><div class="t-tiny mut clip">Оборонная 12 · Пётр К. · 34 900 ₽</div></td><td class="mono t-lbl">29 авг<br><span class="t-tiny fnt">14:00</span></td><td><span class="chip c-primary"><span class="dot"></span>В работе</span></td></tr>
                <tr><td class="mono strong">№ 127</td><td><div class="strong">ООО «Тулаторг»</div><div class="t-tiny mut clip">пр. Ленина 108 · Артём М. · 8 400 ₽</div></td><td class="mono t-lbl">29 авг<br><span class="t-tiny fnt">17:30</span></td><td><span class="chip c-warn"><span class="dot"></span>Назначен</span></td></tr>
                <tr><td class="mono strong">№ 125</td><td><div class="strong">Владислав Гринёв</div><div class="t-tiny mut clip">Металлургов 22 · Иван С. · 12 000 ₽</div></td><td class="mono t-lbl" style="color:var(--error-ink)">31 авг<br><span class="t-tiny">09:00</span></td><td><span class="chip c-danger"><span class="dot"></span>Просрочен</span></td></tr>
              </tbody></table></div></div>
          </div>
        </div></div>
$(head3 390)
        <div class="frame ph" style="min-height:660px">
          <div class="mbar"><span class="row" style="gap:10px"><span class="iconbtn"><svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"/></svg></span><span class="mtitle">Заказы</span></span><span class="btn solid sm icon">$I_PLUS</span></div>
$(trow "$T" 1 xs)
          <div class="mbody">
            <div class="row" style="gap:8px"><span class="btn faded sm">$I_FILT Фильтр <span class="chip c-primary" style="height:17px;padding:0 5px">2</span></span><span class="chip c-primary lg">Этот месяц <span class="x">×</span></span></div>
            <div class="card"><div class="mrow"><div class="row" style="justify-content:space-between"><span class="mono strong">№ 128</span><span class="chip c-primary"><span class="dot"></span>В работе</span></div><span class="strong">Дмитрий Лапшин</span><span class="t-tiny mut">Тула, Оборонная 12, кв. 34</span><hr class="hr"><div class="row" style="justify-content:space-between"><span class="usr"><span class="ava xs">ПК</span><span class="t-tiny">Пётр К.</span></span><span class="mono t-lbl mut">29 авг, 14:00</span><span class="mono strong">34 900 ₽</span></div></div></div>
            <div class="card" style="border-color:var(--error-line)"><div class="mrow"><div class="row" style="justify-content:space-between"><span class="mono strong">№ 125</span><span class="chip c-danger"><span class="dot"></span>Просрочен</span></div><span class="strong">Владислав Гринёв</span><span class="t-tiny mut">Тула, Металлургов 22, кв. 108</span><hr class="hr"><div class="row" style="justify-content:space-between"><span class="usr"><span class="ava xs" style="background:var(--ok-bg);color:var(--ok-ink)">ИС</span><span class="t-tiny">Иван С.</span></span><span class="mono t-lbl" style="color:var(--error-ink)">31 авг, 09:00</span><span class="mono strong">12 000 ₽</span></div></div></div>
          </div>
        </div></div>
    </div>
    <span class="devcap">768 — монтажник и сумма уходят в подпись строки. 390 — карточки, вкладки лентой с затуханием: «Отказы» и «Все» доступны прокруткой.</span>
  </div>

  <!-- 2. НОВЫЕ -->
  <div class="tsec">
$(tsec "Вкладка 2" "Новые" "Заказ есть, исполнителя и времени нет. Пока не назначен монтажник, наряд не попадает в календарь и не виден монтажнику — поэтому у вкладки своё действие в каждой строке.")
    <div class="row3">
$(head3 1440)
        <div class="frame dk">
$(trow "$T" 2)
          <div class="bd20">
            <div class="alert a-warn" style="margin-bottom:12px"><span class="ai">$I_WARN</span><div><div class="at">Два заказа ждут назначения</div><div class="ad">Один создан из заявки вчера. Чем дольше без монтажника, тем выше шанс, что клиент позвонит другим.</div></div></div>
            <div class="card"><div class="bd" style="padding:0"><table class="tbl">
              <thead><tr><th style="width:76px">Номер</th><th>Клиент и объект</th><th style="width:160px">Откуда</th><th style="width:130px">Создан</th><th class="rt" style="width:110px">Сумма</th><th style="width:150px">Действие</th></tr></thead>
              <tbody>
                <tr><td class="mono strong">№ 126</td><td><div class="strong">Алла Викторовна</div><div class="t-tiny mut clip">Щёкино, Пионерская 4 · высотные работы</div></td><td><span class="chip c-default">из заявки № 41</span></td><td class="mono t-lbl">30 авг, 09:12</td><td class="rt mono strong">52 300 ₽</td><td><span class="btn flat sm">Назначить</span></td></tr>
                <tr><td class="mono strong">№ 129</td><td><div class="strong">Максим Ильин</div><div class="t-tiny mut clip">Тула, Кирова 18 · нужен замер</div></td><td><span class="chip c-default">вручную</span></td><td class="mono t-lbl">30 авг, 11:40</td><td class="rt mut">не задана</td><td><span class="btn flat sm">Назначить</span></td></tr>
              </tbody></table></div></div>
          </div>
        </div></div>
$(head3 768)
        <div class="frame tb">
$(trow "$T" 2 sm)
          <div class="bd16">
            <div class="card"><div class="bd" style="padding:0"><table class="tbl">
              <thead><tr><th style="width:70px">Номер</th><th>Клиент и объект</th><th style="width:120px">Создан</th><th style="width:120px">Действие</th></tr></thead>
              <tbody>
                <tr><td class="mono strong">№ 126</td><td><div class="strong">Алла Викторовна</div><div class="t-tiny mut clip">Щёкино, Пионерская 4 · из заявки № 41</div></td><td class="mono t-lbl">30 авг</td><td><span class="btn flat sm">Назначить</span></td></tr>
                <tr><td class="mono strong">№ 129</td><td><div class="strong">Максим Ильин</div><div class="t-tiny mut clip">Тула, Кирова 18 · вручную</div></td><td class="mono t-lbl">30 авг</td><td><span class="btn flat sm">Назначить</span></td></tr>
              </tbody></table></div></div>
          </div>
        </div></div>
$(head3 390)
        <div class="frame ph" style="min-height:660px">
          <div class="mbar"><span class="row" style="gap:10px"><span class="iconbtn"><svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"/></svg></span><span class="mtitle">Заказы</span></span><span class="btn solid sm icon">$I_PLUS</span></div>
$(trow "$T" 2 xs)
          <div class="mbody">
            <div class="card"><div class="mrow"><div class="row" style="justify-content:space-between"><span class="mono strong">№ 126</span><span class="chip c-default"><span class="dot"></span>Новый</span></div><span class="strong">Алла Викторовна</span><span class="t-tiny mut">Щёкино, Пионерская 4</span><span class="chip c-default" style="align-self:flex-start">из заявки № 41</span><span class="btn flat" style="width:100%">Назначить монтажника</span></div></div>
            <div class="card"><div class="mrow"><div class="row" style="justify-content:space-between"><span class="mono strong">№ 129</span><span class="chip c-default"><span class="dot"></span>Новый</span></div><span class="strong">Максим Ильин</span><span class="t-tiny mut">Тула, Кирова 18</span><span class="chip c-default" style="align-self:flex-start">вручную</span><span class="btn flat" style="width:100%">Назначить монтажника</span></div></div>
          </div>
        </div></div>
    </div>
    <span class="devcap">Действие «Назначить» остаётся на всех ширинах: без него вкладка бесполезна. На 390 оно становится кнопкой во всю ширину карточки.</span>
  </div>
</div>
EOF
