{
  "name": "conditioner",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.11.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm --filter web build",
    "budget": "node scripts/js-budget.mjs apps/web/.next",
    "start": "pnpm --filter web start",
    "worker": "pnpm --filter web worker",
    "seed": "pnpm --filter web seed",
    "seed:demo": "pnpm --filter web seed:demo",
    "prisma": "pnpm --filter web prisma",
    "storybook": "pnpm --filter web storybook",
    "storybook:build": "pnpm --filter web build-storybook",
    "test": "pnpm --filter web test",
    "e2e": "pnpm --filter web e2e",
    "e2e:stand": "node scripts/e2e-stand.mjs",
    "vr": "pnpm --filter web vr",
    "shot": "pnpm --filter web shot",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint . --max-warnings 0",
    "lint:css": "stylelint \"apps/**/*.css\"",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "check": "pnpm format:check && pnpm lint && pnpm lint:css && pnpm typecheck && pnpm test",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.0",
    "@commitlint/config-conventional": "^19.6.0",
    "@eslint/eslintrc": "^3.2.0",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.1.0",
    "eslint-config-prettier": "^9.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.11",
    "prettier": "^3.4.2",
    "stylelint": "^16.12.0",
    "stylelint-config-standard": "^36.0.1",
    "typescript": "^5.7.2"
  },
  "lint-staged": {
    "*.{ts,tsx,mjs}": [
      "eslint --max-warnings 0",
      "prettier --check"
    ],
    "apps/web/src/**/*.{ts,tsx}": [
      "scripts/test-related.sh"
    ],
    "*.css": [
      "stylelint",
      "prettier --check"
    ],
    "*.{json,md,yml}": [
      "prettier --check"
    ]
  }
}
